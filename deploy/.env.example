# ---------------------------------------------------------------------------
# Journal website — production settings. Copy to .env and fill in.
# Never commit .env. Values must not contain double quotes (").
# Run ./scripts/generate-secrets.sh to fill the random secrets.
# ---------------------------------------------------------------------------

# Domain and TLS
JOURNAL_DOMAIN=journal.example.org
LETSENCRYPT_EMAIL=admin@example.org

# OJS image version (PKP official, 3.5 LTS line)
OJS_VERSION=3_5_0-5

# Set by scripts/install-ojs.sh after the first installation
OJS_INSTALLED=Off
OJS_APP_KEY=

# Secrets (scripts/generate-secrets.sh)
OJS_SALT=
OJS_API_KEY_SECRET=
OJS_ALTCHA_HMACKEY=

OJS_TIME_ZONE=UTC
# Defaults to ["<JOURNAL_DOMAIN>"]
OJS_ALLOWED_HOSTS=

# First administrator (used only by scripts/install-ojs.sh; remove the
# password from this file after installation)
OJS_ADMIN_USER=admin
OJS_ADMIN_EMAIL=admin@example.org
OJS_ADMIN_PASSWORD=

# Database
OJS_DB_NAME=ojs
OJS_DB_USER=ojs
OJS_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
DB_BUFFER_POOL=512M

# Outgoing email (SMTP) — required in production for notifications to work.
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH=tls
SMTP_USER=
SMTP_PASSWORD=
MAIL_ENVELOPE_SENDER=no-reply@journal.example.org

# Backups (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Encrypts the config/.env archive inside each backup (required)
BACKUP_GPG_PASSPHRASE=
# Optional off-site copy with rclone, e.g. "b2:journal-backups"
RCLONE_REMOTE=
